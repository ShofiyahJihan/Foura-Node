<%
  const rp = n => 'Rp ' + Number(n || 0).toLocaleString('id-ID');
  const inisial = String(locals.nama || '?').charAt(0).toUpperCase();
  const isAdmin = locals.isAdmin ?? (locals.mode === 'admin');
  const role = locals.role || '';
  const perKategori = locals.perKategori || [];
  const maksKat = locals.maksKat || Math.max(1, ...perKategori.map(k => k.jumlah));
  const totalProduk = locals.totalProduk ?? 0;
  const totalKategori = locals.totalKategori ?? 0;
  const totalPengguna = locals.totalPengguna ?? null;
  const pesananBaru = locals.pesananBaru ?? 0;
  const pesananMasuk = locals.pesananMasuk || [];
  const produkTerbaru = locals.produkTerbaru || [];
  const aktivitas = locals.aktivitas || [];
  const ringkasan = locals.ringkasan || { jumlahBulanIni: 0, nilai: 0, menunggu: 0, dikerjakan: 0, selesai: 0 };
  const kelasStatus = locals.kelasStatus || { menunggu: 'baru', dikerjakan: 'proses', selesai: 'ok' };
  const labelStatus = locals.labelStatus || { menunggu: 'Menunggu', dikerjakan: 'Sedang Dikerjakan', selesai: 'Selesai' };
  const paket = locals.paket || null;
  const totalPesanan = locals.totalPesanan ?? 0;
  const pesanan = locals.pesanan || [];
  const progress = locals.progress || null;
  const progressKode = locals.progressKode || '';
%>
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard — Foura Creative</title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="d-app">


  <!-- SIDEBAR -->
  <aside class="d-side">
    <a href="/" class="d-brand">
      <img src="/images/logo.png" alt="Logo Foura Creative">
      <div><b>Foura Creative</b><small>Create, Connect, Grow</small></div>
    </a>
    <nav class="d-menu">
      <a href="/dashboard" class="on"><span>▦</span> Dashboard</a>
      <% if (isAdmin) { %>
  <a href="/admin/pesanan"><span>◈</span> Kelola Pesanan</a>
  <a href="/kelola/produk"><span>▣</span> Kelola Katalog</a>
  <a href="/kelola/kategori"><span>☰</span> Kelola Kategori</a>
  <% if (role === 'admin') { %>
    <a href="/kelola/pengguna"><span>☺</span> Kelola Pengguna</a>
    <a href="/kelola/artikel"><span>✎</span> Kelola Artikel</a>
    <a href="/kelola/tentang"><span>ⓘ</span> Kelola Tentang Kami</a>
  <% } %>
<% } else { %>
  <a href="/riwayat"><span>☰</span> Riwayat Pesanan</a>
  <a href="/profil"><span>☺</span> Profil Pengguna</a>
<% } %>
      <button type="button" id="btnKeluar"><span>⇥</span> Keluar</button>
    </nav>
    <p class="d-quote">More Views<br>More Customers</p>
  </aside>


  <!-- ISI -->
  <main class="d-main">
    <header class="d-top">
      <div class="d-search">
        <input type="search" placeholder="<%= isAdmin ? 'Cari produk, pelanggan, atau pesanan...' : 'Cari pesanan, layanan, atau informasi...' %>">
      </div>
      <div class="d-user">
        <span class="d-bell" title="Notifikasi">🔔<% if (isAdmin && pesananBaru > 0) { %><i></i><% } else if (!isAdmin) { %><i></i><% } %></span>
        <div class="d-chip">
          <% if (locals.fotoUser) { %><img class="d-ava d-ava-img" src="<%= fotoUser %>" alt=""><% } else { %><span class="d-ava"><%= inisial %></span><% } %>
          <div><b><%= locals.nama %></b><small><%= locals.peran %></small></div>
          <span class="d-caret">▾</span>
        </div>
      </div>
    </header>


<% if (isAdmin) { %>
    <!-- =================== ADMIN / SELLER =================== -->
    <div class="d-cols">
      <div class="d-left">


        <section class="d-welcome">
          <div>
            <p class="d-eyebrow">Panel <%= locals.peran %></p>
            <h1><%= locals.nama %></h1>
            <p class="d-muted">Pantau katalog, pengguna, dan pesanan masuk Foura Creative dari satu tempat.</p>
          </div>
          <div class="d-banner"><img src="/images/hero.jpg" alt="Foura Creative"></div>
        </section>


        <div class="d-stats">
          <a class="d-stat" href="/kelola/produk">
            <span class="d-ico">▣</span>
            <div><small>Total Produk</small><strong><%= totalProduk %> produk</strong><em>di katalog layanan</em></div>
            <span class="d-arrow">›</span>
          </a>
          <a class="d-stat" href="/kelola/kategori">
            <span class="d-ico">☰</span>
            <div><small>Kategori</small><strong><%= totalKategori %> kategori</strong><em>paket dan jasa satuan</em></div>
            <span class="d-arrow">›</span>
          </a>
          <% if (role === 'admin') { %>
          <a class="d-stat" href="/kelola/pengguna">
            <span class="d-ico">☺</span>
            <div><small>Pengguna</small><strong><%= totalPengguna === null ? '-' : totalPengguna + ' akun' %></strong><em>terdaftar di situs</em></div>
            <span class="d-arrow">›</span>
          </a>
          <a class="d-stat" href="/kelola/artikel">
            <span class="d-ico">✎</span>
            <div><small>Artikel</small><strong>Kelola Artikel</strong><em>tulis dan terbitkan bacaan</em></div>
            <span class="d-arrow">›</span>
          </a>
          <a class="d-stat" href="/kelola/tentang">
            <span class="d-ico">ⓘ</span>
            <div><small>Tentang Kami</small><strong>Kelola Tentang Kami</strong><em>ubah teks, foto, dan tim</em></div>
            <span class="d-arrow">›</span>
          </a>
          <% } %>
          <a class="d-stat" href="/admin/pesanan">
            <span class="d-ico">◈</span>
            <div><small>Pesanan Baru</small><strong><%= pesananBaru %> pesanan</strong><em>menunggu diproses</em></div>
            <span class="d-arrow">›</span>
          </a>
        </div>


        <h2 class="d-judul">Aksi Cepat</h2>
        <div class="d-aksi">
          <a class="d-btn" href="/kelola/produk/baru">+ Tambah Layanan</a>
          <a class="d-btn-detail" href="/admin/pesanan">Kelola Pesanan</a>
          <a class="d-btn-detail" href="/kelola/produk">Kelola Katalog</a>
          <% if (role === 'admin') { %>
          <a class="d-btn-detail" href="/kelola/artikel">Kelola Artikel</a>
          <a class="d-btn-detail" href="/kelola/tentang">Kelola Tentang Kami</a>
          <% } %>
        </div>


        <div class="d-judul-row">
          <h2 class="d-judul">Pesanan Masuk</h2>
          <a href="/admin/pesanan">Lihat Semua →</a>
        </div>
        <% if (pesananMasuk.length) { %>
          <div class="d-tabel-wrap">
            <table class="d-tabel">
              <thead><tr><th>Kode</th><th>Pelanggan</th><th>Layanan</th><th>Total</th><th>Status</th></tr></thead>
              <tbody>
                <% pesananMasuk.forEach(o => { %>
                  <tr>
                    <td class="kode"><%= o.kode %></td>
                    <td><%= o.pelanggan %></td>
                    <td><%= o.layanan %></td>
                    <td><%= rp(o.total) %></td>
                    <td><span class="d-badge <%= kelasStatus[o.status] %>"><%= labelStatus[o.status] %></span></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="d-kosong">Belum ada pesanan masuk. Pesanan pelanggan akan muncul di sini.</div>
        <% } %>


        <div class="d-judul-row">
          <h2 class="d-judul">Produk Terbaru</h2>
          <a href="/kelola/produk">Kelola Katalog →</a>
        </div>
        <% if (produkTerbaru.length) { %>
          <% produkTerbaru.forEach(p => { %>
            <div class="d-prod">
              <div><b><%= p.nama %></b><small><%= p.kategori %></small></div>
              <span class="h"><%= rp(p.harga) %></span>
            </div>
          <% }) %>
        <% } else { %>
          <div class="d-kosong">Belum ada produk.</div>
        <% } %>
      </div>


      <aside class="d-right">
        <section class="d-card">
          <h3 class="t">Ringkasan Pesanan</h3>
          <small>Nilai pesanan bulan ini (<%= ringkasan.jumlahBulanIni %> pesanan)</small>
          <p class="d-uang"><%= rp(ringkasan.nilai) %></p>
          <div class="d-mini">
            <div><strong><%= ringkasan.menunggu %></strong><small>Menunggu</small></div>
            <div><strong><%= ringkasan.dikerjakan %></strong><small>Dikerjakan</small></div>
            <div><strong><%= ringkasan.selesai %></strong><small>Selesai</small></div>
          </div>
        </section>


        <section class="d-card">
          <h3 class="t">Katalog per Kategori</h3>
          <% perKategori.forEach(k => { %>
            <% const lebar = maksKat ? Math.round(k.jumlah / maksKat * 100) : 0; %>
            <div class="d-bar">
              <div class="d-bar-top"><span><%= k.nama %></span><b><%= k.jumlah %> produk</b></div>
              <div class="d-bar-track"><div class="d-bar-isi" data-lebar="<%= lebar %>"></div></div>
            </div>
          <% }) %>
        </section>


        <section class="d-card">
          <div class="d-akt-head"><h3>Aktivitas Terbaru</h3><a href="/admin/pesanan">Lihat Semua →</a></div>
          <% if (aktivitas.length) { %>
            <ul class="d-akt">
              <% aktivitas.forEach(a => { %>
                <li class="<%= a.selesai ? 'done' : '' %>">
                  <span class="d-dot"><%= a.selesai ? '✓' : '' %></span>
                  <div><b><%= a.judul %></b><p><%= a.ket %></p><small><%= a.tanggal %></small></div>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <div class="d-kosong polos">Belum ada aktivitas.</div>
          <% } %>
        </section>
      </aside>
    </div>


<% } else { %>
    <!-- =================== PELANGGAN =================== -->
    <div class="d-cols">
      <div class="d-left">


        <section class="d-welcome">
          <div>
            <p class="d-eyebrow">Selamat datang kembali,</p>
            <h1><%= locals.nama %> <span class="d-spark">✦</span></h1>
            <p class="d-muted">Terima kasih sudah mempercayakan Foura Creative untuk mengembangkan brand kamu. Yuk, pantau pesanan dan perkembangan proyek kamu di sini.</p>
          </div>
          <div class="d-banner"><img src="/images/hero.jpg" alt="Foura Creative"></div>
        </section>


        <div class="d-stats">
          <a class="d-stat" href="<%= paket ? '/riwayat' : '/katalog' %>">
            <span class="d-ico">▣</span>
            <div>
              <small>Paket Aktif</small>
              <% if (paket) { %>
                <strong><%= paket.nama %></strong><em>Berakhir pada <%= paket.berakhir %></em>
              <% } else { %>
                <strong>Belum ada</strong><em>Pilih paket di katalog</em>
              <% } %>
            </div>
            <span class="d-arrow">›</span>
          </a>
          <a class="d-stat" href="/riwayat">
            <span class="d-ico">◈</span>
            <div><small>Total Pesanan</small><strong><%= totalPesanan %> pesanan</strong><em>dalam 1 bulan terakhir</em></div>
            <span class="d-arrow">›</span>
          </a>
        </div>


        <h2 class="d-judul">Pesanan Terbaru</h2>
        <% if (pesanan.length) { %>
          <% pesanan.forEach(o => { %>
            <article class="d-order">
              <% if (o.gambar) { %>
                <img src="<%= o.gambar %>" alt="<%= o.judul %>">
              <% } else { %>
                <span class="d-ph"><%= String(o.judul).replace(/^Paket\s+/, '').charAt(0) %></span>
              <% } %>
              <div class="d-order-info">
                <small><%= o.kode %></small>
                <h3><%= o.judul %>
                  <span class="d-badge <%= kelasStatus[o.status] %>"><%= labelStatus[o.status] %></span>
                </h3>
                <small><%= o.tanggal %></small>
                <p class="d-harga"><%= rp(o.harga) %><% if (o.satuan) { %> <small>/<%= o.satuan %></small><% } %></p>
              </div>
              <a class="d-btn-detail" href="/riwayat">Lihat Detail ›</a>
            </article>
          <% }) %>
        <% } else { %>
          <div class="d-kosong">
            Kamu belum punya pesanan. Pilih layanan di katalog, masukkan ke keranjang, lalu pesan.
            <br><a class="d-btn" href="/katalog">Lihat Katalog Layanan</a>
          </div>
        <% } %>


        <h2 class="d-judul">Progress Pekerjaan<% if (progressKode) { %> <small>· <%= progressKode %></small><% } %></h2>
        <section class="d-card">
          <% if (progress) { %>
            <div class="d-steps">
              <% progress.forEach(s => { %>
                <div class="d-step <%= s.selesai ? 'done' : '' %>">
                  <span class="d-dot"><%= s.selesai ? '✓' : '' %></span>
                  <b><%= s.label %></b>
                  <small><%= s.tanggal || '-' %></small>
                </div>
              <% }) %>
            </div>
            <div class="d-note">
              <span class="d-ico">▣</span>
              <p>Tim kami sedang mengerjakan konten sesuai dengan timeline yang telah disepakati.<br>Kami akan menginformasikan melalui email atau WhatsApp jika sudah ada update terbaru.</p>
              <a href="/riwayat">Lihat Rincian →</a>
            </div>
          <% } else { %>
            <div class="d-kosong polos">Belum ada pekerjaan berjalan. Progress akan muncul setelah kamu memesan layanan.</div>
          <% } %>
        </section>
      </div>


      <aside class="d-right">
        <section class="d-card">
          <% if (paket) { %>
            <div class="d-paket-top">
              <div>
                <h3>Paket Saya</h3>
                <p class="d-paket-nama"><%= paket.nama %></p>
                <p class="d-harga"><%= rp(paket.harga) %> <small>/<%= paket.satuan %></small></p>
              </div>
              <a class="d-btn" href="/katalog">Upgrade Paket</a>
            </div>
            <% if (paket.benefit.length) { %>
              <h4>Benefit Paket <%= paket.nama %></h4>
              <ul class="d-benefit">
                <% paket.benefit.forEach(b => { %><li><%= b %></li><% }) %>
              </ul>
            <% } %>
          <% } else { %>
            <h3 class="t">Paket Saya</h3>
            <div class="d-kosong polos">Kamu belum punya paket aktif.<br><a class="d-btn" href="/katalog">Lihat Paket</a></div>
          <% } %>
        </section>


        <section class="d-help">
          <img src="/images/konsultasi-rutin.jpg" alt="">
          <div>
            <h3>Butuh bantuan?</h3>
            <p>Tim kami siap membantu kamu kapan saja.</p>
            <!-- GANTI nomor WhatsApp di bawah dengan nomor asli (format 62812..., tanpa + dan spasi) -->
            <a class="d-btn" href="https://wa.me/62812xxxxxxxx" target="_blank" rel="noopener">Hubungi Kami</a>
          </div>
        </section>


        <section class="d-card">
          <div class="d-akt-head"><h3>Riwayat Aktivitas</h3><a href="/riwayat">Lihat Semua →</a></div>
          <% if (aktivitas.length) { %>
            <ul class="d-akt">
              <% aktivitas.forEach(a => { %>
                <li class="<%= a.selesai ? 'done' : '' %>">
                  <span class="d-dot"><%= a.selesai ? '✓' : '' %></span>
                  <div><b><%= a.judul %></b><p><%= a.ket %></p><small><%= a.tanggal %></small></div>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <div class="d-kosong polos">Belum ada aktivitas.</div>
          <% } %>
        </section>
      </aside>
    </div>
<% } %>
  </main>
</div>


<!-- DIALOG KELUAR -->
<dialog id="dlgKeluar" class="d-dialog">
  <button type="button" class="d-x" id="btnBatalX" aria-label="Tutup">×</button>
  <span class="d-dlg-ico">⇥</span>
  <h3>Keluar dari Akun?</h3>
  <p>Kamu akan kembali ke halaman utama. Pastikan semua perubahan sudah tersimpan.</p>
  <div class="d-dlg-aksi">
    <button type="button" class="d-btn-out" id="btnBatal">Batal</button>
    <form method="POST" action="/keluar"><button type="submit" class="d-btn">Keluar</button></form>
  </div>
</dialog>


<script>
  const dlg = document.getElementById('dlgKeluar');
  document.getElementById('btnKeluar').addEventListener('click', () => dlg.showModal());
  ['btnBatal', 'btnBatalX'].forEach(id => document.getElementById(id).addEventListener('click', () => dlg.close()));
  dlg.addEventListener('click', e => { if (e.target === dlg) dlg.close(); });
  document.querySelectorAll('.d-bar-isi').forEach(el => { el.style.width = el.dataset.lebar + '%'; });
</script>
</body>
</html>