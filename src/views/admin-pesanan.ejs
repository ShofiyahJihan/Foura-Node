<%- include('partials/dash-header', { aktif: 'pesanan', judul: 'Kelola Pesanan' }) %>
<% const rp = n => 'Rp ' + Number(n).toLocaleString('id-ID'); %>

<section class="ap-wrap">
  <p class="d-eyebrow">Kelola</p>
  <h1 class="ap-judul">Kelola Pesanan</h1>
  <p class="d-muted">Ubah tahap pekerjaan. Perubahan langsung terlihat di dashboard pelanggan.</p>

  <form method="POST" action="/pembayaran/admin/cek-semua" style="margin:12px 0">
    <button type="submit" class="d-btn">Cek status semua pembayaran</button>
  </form>

  <% if (!daftar.length) { %>
    <div class="d-kosong ap-kosong">Belum ada pesanan masuk.</div>
  <% } else { %>
    <% daftar.forEach(p => { %>
      <%
        const nomor = String(p.wa || '').replace(/\D/g, '').replace(/^0/, '62');
        const sapa = 'Halo ' + p.pelanggan + ', kami dari Foura Creative terkait pesanan ' + p.kode + '.';
      %>
      <article class="ap-item">
        <div class="ap-atas">
          <div>
            <b class="ap-kode"><%= p.kode %></b>
            <span class="d-badge <%= p.status === 'selesai' ? 'ok' : (p.status === 'dikerjakan' ? 'proses' : 'baru') %>"><%= LABEL_STATUS[p.status] %></span>
            <p class="ap-meta"><%= p.pelanggan %> · <%= p.tanggal %></p>
            <% if (nomor) { %>
              <a class="ap-wa" href="https://wa.me/<%= nomor %>?text=<%= encodeURIComponent(sapa) %>" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2-.1-.1-.3-.2-.6-.3z"/></svg>
                <%= p.wa %>
              </a>
            <% } else { %>
              <small class="ap-wa-kosong">Nomor WhatsApp belum tercatat</small>
            <% } %>
            <p class="ap-bayar">
              <span class="d-badge <%= p.bayar === 'lunas' ? 'ok' : 'baru' %>">
                <%= p.bayar === 'lunas' ? 'Lunas' : (p.bayar === 'menunggu_verifikasi' ? 'Menunggu verifikasi' : 'Belum bayar') %>
              </span>
              <% if (p.adaOrder && p.bayar !== 'lunas') { %>
                <button type="submit" form="cek-<%= p.id %>" class="ap-cek">Cek status</button>
              <% } %>
            </p>
          </div>
          <b class="ap-total"><%= rp(p.total) %></b>
        </div>
        <ul class="ap-list">
          <% p.items.forEach(i => { %><li><%= i.nama %> × <%= i.jumlah %> — <%= rp(i.harga * i.jumlah) %></li><% }) %>
        </ul>
        <% if (p.catatan) { %><p class="ap-catatan">Catatan: <%= p.catatan %></p><% } %>
        <form method="POST" action="/admin/pesanan/<%= p.id %>/tahap" class="ap-form">
          <label>Tahap pekerjaan
            <select name="tahap">
              <option value="0" <%= p.tahap === 0 ? 'selected' : '' %>>Menunggu diproses</option>
              <% TAHAP.forEach((t, i) => { %>
                <option value="<%= i + 1 %>" <%= p.tahap === i + 1 ? 'selected' : '' %>><%= t %> selesai</option>
              <% }) %>
            </select>
          </label>
          <button type="submit" class="d-btn">Simpan</button>
        </form>
        <form id="cek-<%= p.id %>" method="POST" action="/pembayaran/admin/cek/<%= p.id %>"></form>
      </article>
    <% }) %>
  <% } %>
</section>

<%- include('partials/dash-footer') %>