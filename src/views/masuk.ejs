<%- include('partials/header') %>
<section class="auth-page">
  <div class="auth-card">
    <h1>Masuk ke Foura Creative</h1>
    <p class="auth-sub">Kelola dan pantau pesanan jasa media sosial kamu</p>

    <% if (error) { %><p class="auth-error"><%= error %></p><% } %>

    <form method="post" action="/masuk">
      <input type="hidden" name="next" value="<%= next %>">
      <input class="auth-input" name="username" value="<%= username %>" placeholder="Username" aria-label="Username" required autofocus autocomplete="username">
      <input class="auth-input" type="password" name="password" placeholder="Password" aria-label="Password" required autocomplete="current-password">
      <button class="auth-btn">Masuk</button>
    </form>

    <p class="auth-foot">Belum punya akun? <a href="/daftar">Daftar</a></p>
  </div>
</section>
<%- include('partials/footer') %>