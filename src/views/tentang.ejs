<%- include('partials/header') %>

<%
const IKON = {
  bulb:  '<path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-4 10.5c.7.7 1 1.5 1 2.5h6c0-1 .3-1.8 1-2.5A6 6 0 0 0 12 3z"/>',
  users: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 7M18 14a6.5 6.5 0 0 1 3.5 6"/>',
  chart: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
  heart: '<path d="M12 20s-8-5-8-11a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 9c0 6-8 11-8 11z"/>',
};
const X = T.teks;
const miring = s => String(s || '')
  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
  .replace(/\*(.+?)\*/g, '<em>$1</em>');
%>

<!-- 1. Hero -->
<section class="ar-hero tt-hero2" style="--hero-img:url('<%= X.hero_gambar %>')">
  <div class="ar-hero-in">
    <p class="ar-eyebrow">TENTANG FOURA CREATIVE</p>
        <h1><%- miring(X.hero_judul) %></h1>
    <p class="ar-sub"><%= X.hero_teks %></p>
  </div>
</section>

<!-- 2. Cerita kami -->
<section class="tt-blok tt-cerita">
  <div class="tt-foto-kartu" style="background-image:url('<%= X.cerita_gambar %>')"></div>
  <div>
    <p class="tt-eyebrow">CERITA KAMI</p>
    <h2><%= X.cerita_judul %></h2>
    <p><%= X.cerita_1 %></p>
    <p><%= X.cerita_2 %></p>
    <a class="tt-btn" href="/katalog"><%= X.cerita_tombol %></a>
  </div>
</section>

<!-- 3. Keunggulan -->
<section class="tt-blok">
  <div class="tt-unggul">
    <% T.keunggulan.forEach(k => { %>
      <div class="tt-unggul-item">
        <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><%- IKON[k.ikon] || '' %></svg>
        <h3><%= k.judul %></h3>
        <p><%= k.teks %></p>
      </div>
    <% }) %>
  </div>
</section>

<!-- 4. Tim kami -->
<section class="tt-blok tt-tim">
  <div class="tt-tim-teks">
    <h2><%= X.tim_judul %></h2>
    <p><%= X.tim_teks %></p>
  </div>
  <div class="tt-tim-grid">
    <% T.tim.forEach(o => { %>
      <figure class="tt-orang">
        <div class="tt-orang-foto">
          <span><%= o.judul.charAt(0) %></span>
          <% if (o.foto) { %><img src="<%= o.foto %>" alt="<%= o.judul %>" loading="lazy" onerror="this.remove()"><% } %>
        </div>
        <figcaption>
          <b><%= o.judul %></b>
          <small><%= o.teks %></small>
        </figcaption>
      </figure>
    <% }) %>
  </div>
</section>

<!-- 5. Nilai & visi -->
<section class="tt-blok tt-nilai">
  <div class="tt-foto-kartu" style="background-image:url('<%= X.nilai_gambar %>')"></div>
  <div>
    <p class="tt-eyebrow">NILAI &amp; VISI</p>
    <h2><%= X.nilai_judul %></h2>
    <div class="tt-nilai-grid">
      <% T.nilai.forEach(n => { %>
        <div><b><%= n.judul %></b><p><%= n.teks %></p></div>
      <% }) %>
    </div>
  </div>
</section>

<!-- 6. Ajakan -->
<section class="tt-blok tt-cta">
  <div>
    <p class="tt-eyebrow"><%= X.cta_eyebrow %></p>
    <h2><%= X.cta_judul %></h2>
  </div>
  <a class="tt-btn tt-btn-terang" href="https://wa.me/<%= String(S.kontak_wa).replace(/\D/g, '').replace(/^0/, '62') %>" target="_blank" rel="noopener"><%= X.cta_tombol %></a>
</section>

<%- include('partials/footer') %>