<span class="fd-aksi">
  <button type="button" class="fd-btn <%= a.sukaAktif ? 'on' : '' %>" data-aksi="suka" data-slug="<%= a.slug %>" aria-pressed="<%= a.sukaAktif %>" aria-label="Suka">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"/></svg>
    <span class="n"><%= a.suka %></span>
  </button>
  <a class="fd-btn" href="/artikel/<%= a.slug %>#komentar" aria-label="Komentar">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8z"/></svg>
    <span><%= a.komentar %></span>
  </a>
</span>

