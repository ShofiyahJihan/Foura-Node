<%- include('../partials/header') %>
<section class="page">
  <div class="bar"><h1>Kelola Kategori</h1><a class="btn" href="/kelola/kategori/baru">+ Tambah Kategori</a></div>
  <% if (daftar.length) { %>
  <div class="scroll-x"><table class="tabel">
    <thead><tr><th></th><th>Nama</th><th>Deskripsi</th><th>Produk</th><th>Aksi</th></tr></thead>
    <tbody>
    <% daftar.forEach(k => { %>
      <tr>
        <td><% if (k.image) { %><img class="thumb" src="/uploads/<%= k.image %>" alt=""><% } %></td>
        <td><b><%= k.name_kategori %></b></td>
        <td class="muted"><%= k.deskripsi_kategori || '-' %></td>
        <td><%= k.products.length %></td>
        <td class="aksi-sel">
          <a class="btn ghost sm" href="/kelola/kategori/<%= k.id %>/edit">Ubah</a>
          <form method="post" action="/kelola/kategori/<%= k.id %>/hapus" onsubmit="return confirm('Hapus kategori ini? <%= k.products.length %> produk di dalamnya ikut terhapus.')"><button class="btn bahaya sm">Hapus</button></form>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } else { %><p class="kosong">Belum ada kategori.</p><% } %>
</section>
<%- include('../partials/footer') %>
