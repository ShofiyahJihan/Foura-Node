<%- include('partials/pay-head') %>
<main class="page by-page">

<% if (pesanan.status_bayar === 'lunas') { %>

  <div class="by-sukses">
    <div class="by-centang">✓</div>
    <h1 class="kr-judul">Pesanan diterima</h1>
    <p class="muted">Pembayaran berhasil. Kode pesanan kamu <b class="by-kode"><%= pesanan.kode %></b></p>
  </div>

<% } else { %>

  <div class="by-sukses">
    <h1 class="kr-judul">Selesaikan pembayaran</h1>
    <p class="muted">Kode pesanan <b class="by-kode"><%= pesanan.kode %></b>. Pesanan baru dianggap diterima setelah pembayaran berhasil.</p>
  </div>

<% } %>

  <div class="kr-grid by-form">
    <div>
      <section class="by-kartu">
        <h3>Pembayaran</h3>
        <p>Total yang harus dibayar: <b class="by-total"><%= rupiah(pesanan.total) %></b></p>

        <p>Status pembayaran:
          <% if (pesanan.status_bayar === 'lunas') { %><span class="st ok">Lunas</span>
          <% } else { %><span class="st wait">Menunggu pembayaran</span><% } %>
        </p>

        <% if (pesanan.status_bayar !== 'lunas') { %>
          <button type="button" id="btnBayar" class="kr-btn by-btn-kecil">Bayar Sekarang</button>
          <p class="kr-kecil">Jendela pembayaran Midtrans terbuka otomatis satu kali. Kalau kamu menutupnya, klik tombol di atas untuk membukanya lagi. Menutup jendela tidak membayar apa pun.</p>
        <% } else { %>
          <p class="muted">Tim kami akan menghubungi <b><%= pesanan.no_hp %></b> untuk brief.</p>
        <% } %>
      </section>
    </div>

    <aside class="kr-ringkas">
      <h3>Pesananmu</h3>
      <% pesanan.items.forEach(function (i) { %>
        <div class="by-item">
          <div><b><%= i.nama %></b><small><%= i.jumlah %> × <%= rupiah(i.harga) %></small></div>
          <span><%= rupiah(i.harga * i.jumlah) %></span>
        </div>
      <% }) %>
      <div class="kr-total"><span>Total</span><b><%= rupiah(pesanan.total) %></b></div>
      <% if (pesanan.catatan) { %><p class="kr-kecil">Catatan: <%= pesanan.catatan %></p><% } %>
      <% if (pesanan.status_bayar === 'lunas') { %>
        <a class="kr-btn by-link-btn" href="/riwayat">Lihat riwayat pesanan</a>
      <% } else { %>
        <p class="kr-kecil"><a href="/keranjang">← Kembali ke keranjang</a></p>
      <% } %>
    </aside>
  </div>
</main>

<% if (pesanan.status_bayar !== 'lunas') { %>
<script src="<%= snapUrl %>" data-client-key="<%= clientKey %>"></script>
<script>
  var kode = encodeURIComponent('<%= pesanan.kode %>');
  var btn = document.getElementById('btnBayar');

  // Cek status ke server; muat ulang halaman hanya kalau sudah lunas
  function cekStatus() {
    return fetch('/pembayaran/selesai/' + kode + '/cek', { method: 'POST', credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (d && d.ok && (d.status === 'settlement' || d.status === 'capture')) location.reload();
      })
      .catch(function () {});
  }

  function bayar() {
    btn.disabled = true;
    fetch('/pembayaran/selesai/' + kode + '/snap', { method: 'POST', credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (!d.token) throw new Error(d.error || 'Gagal membuka pembayaran.');
        window.snap.pay(d.token, {
          onSuccess: function () { cekStatus(); },
          onPending: function () { btn.disabled = false; cekStatus(); },
          onError: function () { alert('Pembayaran gagal, coba lagi.'); btn.disabled = false; },
          onClose: function () { btn.disabled = false; cekStatus(); }
        });
      })
      .catch(function (e) { alert(e.message); btn.disabled = false; });
  }

  btn.addEventListener('click', bayar);

  // Buka otomatis hanya SEKALI per pesanan, supaya tidak muncul lagi setelah ditutup
  var kunci = 'bayar-' + kode;
  if (!sessionStorage.getItem(kunci)) {
    sessionStorage.setItem(kunci, '1');
    window.addEventListener('load', bayar);
  }
</script>
<% } %>
<%- include('partials/pay-foot') %>