<%- include('../partials/dash-header', { aktif: 'artikel', judul: 'Kelola Tentang Kami' }) %>

<%
const NAMA = { keunggulan: 'Keunggulan', tim: 'Tim Kami', nilai: 'Nilai & Visi' };
const daftar = T[jenis] || [];
%>
<section class="page">
  <div class="bar">
    <h1>Ubah <%= NAMA[jenis] %></h1>
    <a class="btn" href="/kelola/tentang/item/baru/<%= jenis %>">+ Tambah</a>
  </div>

  <% if (daftar.length) { %>
  <div class="scroll-x"><table class="tabel">
    <thead><tr>
      <th><%= jenis === 'tim' ? 'Nama' : 'Judul' %></th>
      <th><%= jenis === 'tim' ? 'Jabatan' : 'Teks' %></th>
      <th>Urutan</th>
      <th>Aksi</th>
    </tr></thead>
    <tbody>
    <% daftar.forEach(x => { %>
      <tr>
        <td><b><%= x.judul %></b></td>
        <td class="muted"><%= (x.teks || '-').slice(0, 90) %></td>
        <td><%= x.urutan %></td>
        <td class="aksi-sel">
          <a class="btn ghost sm" href="/kelola/tentang/item/<%= x.id %>/edit">Ubah</a>
          <form method="post" action="/kelola/tentang/item/<%= x.id %>/hapus" onsubmit="return confirm('Hapus item ini?')"><button class="btn bahaya sm">Hapus</button></form>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } else { %><p class="kosong">Belum ada data. Klik "+ Tambah" untuk membuat yang pertama.</p><% } %>

  <p style="margin-top:1rem"><a class="btn ghost" href="/kelola/tentang">← Kembali</a></p>
</section>

<%- include('../partials/dash-footer') %>