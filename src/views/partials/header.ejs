<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.title ? title + ' — ' : '' %>Foura Creative</title>

  <%
    // Info pratinjau saat link dibagikan (Open Graph).
    // Halaman artikel mengirim `og`; halaman lain memakai isian bawaan.
    const og = locals.og || {};
    const ogJudul = og.judul || ((locals.title ? title + ' — ' : '') + 'Foura Creative');
    const ogDeskripsi = og.deskripsi || 'Jasa pengelolaan media sosial untuk UMKM fashion di Makassar. Konten, jadwal posting, sampai laporan performa bulanan.';
  %>
  <meta name="description" content="<%= ogDeskripsi %>">
  <meta property="og:site_name" content="Foura Creative">
  <meta property="og:type" content="<%= og.tipe || 'website' %>">
  <meta property="og:locale" content="id_ID">
  <meta property="og:title" content="<%= ogJudul %>">
  <meta property="og:description" content="<%= ogDeskripsi %>">
  <% if (og.url) { %><meta property="og:url" content="<%= og.url %>"><% } %>
  <% if (og.gambar) { %>
    <meta property="og:image" content="<%= og.gambar %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="<%= og.gambar %>">
  <% } else { %>
    <meta name="twitter:card" content="summary">
  <% } %>
  <meta name="twitter:title" content="<%= ogJudul %>">
  <meta name="twitter:description" content="<%= ogDeskripsi %>">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/keranjang.js" defer></script>
</head>
<body>


<header class="nav" id="nav">
  <div class="nav-pill">


    <a class="brand" href="/">
      <img src="/images/logo.png" alt="Logo Foura Creative" class="logo-img">
      <span class="brand-name">Foura Creative</span>
    </a>


    <nav class="links">
      <a href="/" class="<%= path === '/' ? 'active' : '' %>">Beranda</a>
      <a href="/katalog" class="<%= path.startsWith('/katalog') || path.startsWith('/produk') ? 'active' : '' %>">Katalog Layanan</a>
      <a href="/artikel" class="<%= path.startsWith('/artikel') ? 'active' : '' %>">Artikel</a>
      <a href="/tentang" class="<%= path.startsWith('/tentang') ? 'active' : '' %>">Tentang Kami</a>
    </nav>


    <div class="aksi">
      <% if (typeof user !== 'undefined' && user) { %>


        <% if (role === 'customer') { %>
          <% const jml = (typeof jumlahKeranjang !== 'undefined' && jumlahKeranjang) ? Number(jumlahKeranjang) : 0; %>
          <a href="/keranjang" class="nav-cart" aria-label="Keranjang" title="Keranjang">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3 4h2.2l2.1 10.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.5L20.5 8H6.1"/>
              <circle cx="9.5" cy="19.5" r="1.4"/>
              <circle cx="17" cy="19.5" r="1.4"/>
            </svg>
            <span class="nav-cart-badge" id="navCartBadge" <%= jml > 0 ? '' : 'hidden' %>><%= jml > 99 ? '99+' : jml %></span>
          </a>
        <% } %>


        <a href="/dashboard" class="nav-avatar" title="Dashboard">
          <% if (typeof fotoUser !== 'undefined' && fotoUser) { %>
            <img src="<%= fotoUser %>" alt="Foto profil">
          <% } else { %>
            <%= String(user.first_name || user.username || 'U').charAt(0).toUpperCase() %>
          <% } %>
        </a>


      <% } else { %>
        <a class="btn-outline" href="/masuk">Masuk</a>
        <a class="btn-solid" href="/daftar">Daftar</a>
      <% } %>
    </div>


  </div>
</header>


<script>
  // Perbarui angka badge keranjang tanpa refresh
  window.updateCartBadge = function (jumlah) {
    var badge = document.getElementById('navCartBadge');
    if (!badge) return;
    jumlah = Number(jumlah) || 0;
    badge.textContent = jumlah > 99 ? '99+' : jumlah;
    badge.hidden = jumlah <= 0;
  };


  // Alternatif: cukup kirim event dari file JS mana pun
  // document.dispatchEvent(new CustomEvent('keranjang:update', { detail: { jumlah: 3 } }));
  document.addEventListener('keranjang:update', function (e) {
    window.updateCartBadge(e.detail && e.detail.jumlah);
  });
</script>


<% if (flash) { %><div class="pesan"><p class="<%= flash.type %>"><%= flash.msg %></p></div><% } %>


<main>