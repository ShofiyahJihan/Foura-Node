<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/artikel-detail.css">

<style>
  /* Tombol aksi (suka & komentar) */
  .aksi-bar { display: flex; align-items: center; gap: 12px; }
  .aksi-btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 16px; border: 0; border-radius: 999px;
    background: transparent; color: #6b1f3a;
    font: inherit; font-size: 1.05rem; line-height: 1;
    cursor: pointer; text-decoration: none;
    transition: background .15s, transform .1s;
  }
  .aksi-btn:hover { background: rgba(107, 31, 58, .08); }
  .aksi-btn:active { transform: scale(.96); }
  .aksi-btn:disabled { opacity: .6; cursor: wait; }
  .aksi-btn svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform .15s, fill .15s; }
  .aksi-btn.suka.aktif { background: rgba(107, 31, 58, .1); }
  .aksi-btn.suka.aktif svg { fill: currentColor; }
  .aksi-btn.suka.pop svg { animation: pop .3s ease; }
  @keyframes pop { 0% { transform: scale(1); } 50% { transform: scale(1.35); } 100% { transform: scale(1); } }
</style>

<article class="dt-wrap">

  <header class="dt-kepala">
    <% if (!a.terbit) { %>
      <p class="err">Pratinjau: artikel ini belum diterbitkan dan hanya terlihat oleh admin.</p>
    <% } %>
    <% if (a.kategori) { %>
      <a class="dt-badge" href="/artikel?kategori=<%= encodeURIComponent(a.kategori) %>"><%= a.kategori %></a>
    <% } %>
    <h1 class="dt-judul"><%= a.judul %></h1>

    <div class="dt-penulis">
      <% if (a.penulisFoto) { %>
        <img class="dt-ava" src="<%= a.penulisFoto %>" alt="">
      <% } else { %>
        <span class="dt-ava"><%= (a.penulis || 'T').charAt(0).toUpperCase() %></span>
      <% } %>
      <b><%= a.penulis || 'Tim Foura Creative' %></b>
      <span>· <%= a.tanggal %></span>
    </div>
  </header>

  <% if (a.gambar) { %>
    <img class="dt-sampul" src="<%= a.gambar %>" alt="<%= a.judul %>">
  <% } %>

  <div class="dt-layout">

    <!-- KIRI -->
    <div class="dt-utama">

      <div class="dt-bar">
        <div class="aksi-bar">
          <!-- Tombol love -->
          <button type="button"
                  class="aksi-btn suka <%= a.sukaAktif ? 'aktif' : '' %>"
                  data-slug="<%= a.slug %>"
                  data-jenis="suka"
                  aria-pressed="<%= a.sukaAktif ? 'true' : 'false' %>"
                  aria-label="Suka artikel ini">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"/>
            </svg>
            <span class="jumlah"><%= a.suka %></span>
          </button>

          <!-- Tombol komentar (menggulir ke bagian komentar) -->
          <a class="aksi-btn" href="#komentar" aria-label="Lihat komentar">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.6 8.6 0 0 1-3.8-.9L3 21l1.9-5.1A8.4 8.4 0 1 1 21 11.5z"/>
            </svg>
            <span><%= komentar.length %></span>
          </a>
        </div>
      </div>

      <div class="dt-teks">
        <% a.isi.forEach(b => { %>
          <% if (b.tipe === 'h2') { %>
            <h2><%= b.teks %></h2>
          <% } else if (b.tipe === 'ul') { %>
            <ul><% b.item.forEach(i => { %><li><%= i %></li><% }) %></ul>
          <% } else { %>
            <p><%= b.teks %></p>
          <% } %>
        <% }) %>
      </div>

      <section class="dt-kom" id="komentar">
        <h3>Komentar (<%= komentar.length %>)</h3>

        <% if (login) { %>
          <form class="dt-kom-form" method="POST" action="/artikel/<%= a.slug %>/komentar">
            <textarea name="isi" maxlength="1000" placeholder="Tulis komentar kamu…" required></textarea>
            <button type="submit">Kirim komentar</button>
          </form>
        <% } else { %>
          <p class="dt-kom-info">Masuk untuk menulis komentar.</p>
        <% } %>

        <% komentar.forEach(k => { %>
          <div class="dt-kom-item">
            <div class="dt-kom-kepala">
              <b><%= k.nama %></b>
              <small><%= k.waktu %></small>
              <% if (k.milikku) { %>
                <form method="POST" action="/artikel/<%= a.slug %>/komentar/<%= k.id %>/hapus" onsubmit="return confirm('Hapus komentar ini?')">
                  <button type="submit" class="dt-kom-hapus">Hapus</button>
                </form>
              <% } %>
            </div>
            <p><%= k.isi %></p>
          </div>
        <% }) %>
      </section>
    </div>

    <!-- KANAN -->
    <aside class="dt-samping">
      <div class="dt-kartu">
        <small>Ditulis oleh</small>
        <div class="dt-orang">
          <% if (a.penulisFoto) { %>
            <img class="dt-ava besar" src="<%= a.penulisFoto %>" alt="">
          <% } else { %>
            <span class="dt-ava besar"><%= (a.penulis || 'T').charAt(0).toUpperCase() %></span>
          <% } %>
          <div>
            <b><%= a.penulis || 'Tim Foura Creative' %></b>
            <span>Penulis di Foura Creative</span>
          </div>
        </div>
        <div class="dt-tgl"><%= a.tanggal %></div>
      </div>

      <div class="dt-cta">
        <h3>Butuh bantuan mengelola media sosial brand kamu?</h3>
        <p>Lihat paket dan layanan Foura Creative.</p>
        <a href="/katalog">Lihat Katalog Layanan</a>
      </div>
    </aside>
  </div>
</article>

<% if (lain.length) { %>
<section class="dt-lain">
  <h2>Baca juga</h2>
  <div class="dt-lain-grid">
    <% lain.forEach(l => { %>
      <a class="dt-lain-kartu" href="/artikel/<%= l.slug %>">
        <div class="dt-lain-thumb">
          <% if (l.gambar) { %>
            <img src="<%= l.gambar %>" alt="">
          <% } else { %>
            <span><%= (l.judul || 'A').charAt(0).toUpperCase() %></span>
          <% } %>
        </div>
        <div class="dt-lain-isi">
          <% if (l.kategori) { %><span class="dt-lain-kat"><%= l.kategori %></span><% } %>
          <h3><%= l.judul %></h3>
          <p><%= l.ringkasan %></p>
          <small><%= l.tanggal %> · <%= l.menit %> menit baca</small>
        </div>
      </a>
    <% }) %>
  </div>
</section>
<% } %>

<script>
  // Tombol love: kirim ke server, lalu perbarui tampilan tanpa reload
  document.addEventListener('click', async function (e) {
    var tombol = e.target.closest('.aksi-btn[data-jenis]');
    if (!tombol) return;
    tombol.disabled = true;
    try {
      var res = await fetch(
        '/artikel/' + encodeURIComponent(tombol.dataset.slug) + '/reaksi/' + tombol.dataset.jenis,
        { method: 'POST', headers: { 'Accept': 'application/json' }, credentials: 'same-origin' }
      );
      var data = await res.json();
      if (res.status === 401) { window.location.href = data.login || '/masuk'; return; }
      if (!res.ok) throw new Error('gagal');

      tombol.classList.toggle('aktif', data.aktif);
      tombol.setAttribute('aria-pressed', data.aktif ? 'true' : 'false');
      tombol.querySelector('.jumlah').textContent = data.jumlah;
      tombol.classList.remove('pop'); void tombol.offsetWidth; tombol.classList.add('pop');
    } catch (err) {
      alert('Gagal memproses, coba lagi.');
    } finally {
      tombol.disabled = false;
    }
  });
</script>

<%- include('../partials/footer') %>

