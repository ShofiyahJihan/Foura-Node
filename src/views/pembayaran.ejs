<%- include('partials/pay-head') %>
<main class="page by-page">
  <h1 class="kr-judul">Pembayaran</h1>
  <p class="muted">Periksa pesananmu dan isi data. Metode pembayaran dipilih di langkah berikutnya.</p>

  <form method="post" action="/pembayaran" enctype="multipart/form-data" class="kr-grid by-form">
    <% items.forEach(function (i) { %><input type="hidden" name="pilih" value="<%= i.rid %>"><% }) %>
    <div>
      <% if (errors && errors.length) { %>
        <div class="by-error"><% errors.forEach(function (e) { %><p><%= e %></p><% }) %></div>
      <% } %>

      <section class="by-kartu">
        <h3>Data pemesan</h3>
        <div class="by-baris">
          <label>Nama depan
            <input name="nama_depan" value="<%= isi.nama_depan %>" required maxlength="100">
          </label>
          <label>Nama belakang (opsional)
            <input name="nama_belakang" value="<%= isi.nama_belakang %>" maxlength="100">
          </label>
        </div>
        <div class="by-baris">
          <label>Nomor WhatsApp
            <input name="no_hp" value="<%= isi.no_hp %>" required inputmode="tel" placeholder="081234567890">
          </label>
          <label>Email (opsional)
            <input name="email" type="email" value="<%= isi.email %>" maxlength="255">
          </label>
        </div>
        <label>Nama UMKM (opsional)
          <input name="nama_umkm" value="<%= isi.nama_umkm %>" maxlength="150">
        </label>
        <label>Alamat (opsional)
          <textarea name="alamat" maxlength="500"><%= isi.alamat %></textarea>
        </label>
        <label>Catatan untuk tim (opsional)
          <textarea name="catatan" maxlength="1000" placeholder="Contoh: brand fashion hijab, target usia 20-30"><%= isi.catatan %></textarea>
        </label>
      </section>

      <section class="by-kartu">
        <h3>Metode pembayaran</h3>
        <p class="muted">Setelah klik <b>Konfirmasi Pesanan</b>, jendela pembayaran Midtrans akan terbuka. Di sana kamu bisa memilih metode pembayaran yang tersedia.</p>
      </section>
    </div>

    <aside class="kr-ringkas">
      <h3>Ringkasan</h3>
      <% items.forEach(function (i) { %>
        <div class="by-item">
          <div><b><%= i.nama %></b><small><%= i.jumlah %> × <%= rupiah(i.harga) %></small></div>
          <span><%= rupiah(i.subtotal) %></span>
        </div>
      <% }) %>
      <div class="kr-total"><span>Total</span><b><%= rupiah(total) %></b></div>
      <button class="kr-btn" type="submit">Konfirmasi Pesanan</button>
      <p class="kr-kecil"><a href="/keranjang">← Kembali ke keranjang</a></p>
      <p class="kr-kecil">Pesanan baru diproses setelah pembayaran berhasil. Tim kami akan menghubungi kamu lewat WhatsApp untuk brief.</p>
    </aside>
  </form>
</main>
<%- include('partials/pay-foot') %>