<%- include('partials/header') %>
<% const rp = n => 'Rp ' + Number(n).toLocaleString('id-ID'); %>
<section class="page">
  <h1 class="kr-judul">Keranjang</h1>

  <% if (!item.length) { %>
    <div class="kr-kosong">
      <p>Keranjang kamu masih kosong.</p>
      <a class="btn-tambah" href="/katalog">Lihat Katalog Layanan</a>
    </div>
  <% } else { %>
    <div class="kr-grid">
      <div>
        <label style="flex-direction:row;align-items:center;gap:.5rem;margin:0 0 .8rem;font-size:.9rem;cursor:pointer">
          <input type="checkbox" id="pilihSemua" checked style="width:18px;height:18px;accent-color:#6b2737"> Pilih semua
        </label>

        <% item.forEach(i => { %>
          <article class="kr-item">
            <input type="checkbox" class="pilih-item" name="pilih" value="<%= i.id %>" form="formPesan"
                   data-sub="<%= i.harga * i.jumlah %>" checked
                   style="width:20px;height:20px;accent-color:#6b2737;flex-shrink:0;cursor:pointer" aria-label="Pilih <%= i.nama %>">
            <% if (i.gambar) { %>
              <img src="<%= i.gambar %>" alt="<%= i.nama %>">
            <% } else { %>
              <span class="kr-ph"><%= i.nama.replace(/^Paket\s+/, '').charAt(0) %></span>
            <% } %>
            <div class="kr-info">
              <small><%= i.kategori %></small>
              <h3><%= i.nama %></h3>
              <p><%= rp(i.harga) %> <% if (i.satuan) { %><small>/<%= i.satuan %></small><% } %></p>
            </div>
            <div class="kr-qty">
              <form method="POST" action="/keranjang/<%= i.id %>/ubah"><input type="hidden" name="aksi" value="kurang"><button type="submit">−</button></form>
              <span><%= i.jumlah %></span>
              <form method="POST" action="/keranjang/<%= i.id %>/ubah"><input type="hidden" name="aksi" value="tambah"><button type="submit">+</button></form>
            </div>
            <b class="kr-sub"><%= rp(i.harga * i.jumlah) %></b>
            <form method="POST" action="/keranjang/<%= i.id %>/hapus"><button type="submit" class="kr-hapus" title="Hapus">×</button></form>
          </article>
        <% }) %>
      </div>

      <aside class="kr-ringkas">
        <h3>Ringkasan</h3>
        <p class="kr-kecil" style="margin:0 0 .6rem"><span id="jmlPilih"><%= item.length %></span> item dipilih</p>
        <div class="kr-total"><span>Total</span><b id="totalPilih"><%= rp(total) %></b></div>
        <form id="formPesan" method="GET" action="/pembayaran">
          <label>Catatan untuk tim (opsional)
            <textarea name="catatan" placeholder="Contoh: brand fashion hijab, target usia 20-30"></textarea>
          </label>
          <button type="submit" id="btnPesan" class="btn-tambah kr-btn">Pesan Sekarang</button>
        </form>
        <p class="kr-kecil">Item yang tidak dicentang tetap ada di keranjang. Setelah memesan, tim kami akan menghubungi kamu untuk brief dan pembayaran.</p>
      </aside>
    </div>
  <% } %>
</section>

<script>
  (function () {
    var cek = document.querySelectorAll('.pilih-item');
    if (!cek.length) return;
    var semua = document.getElementById('pilihSemua');
    var btn = document.getElementById('btnPesan');

    function hitung() {
      var total = 0, n = 0;
      cek.forEach(function (c) { if (c.checked) { total += Number(c.dataset.sub); n++; } });
      document.getElementById('totalPilih').textContent = 'Rp ' + total.toLocaleString('id-ID');
      document.getElementById('jmlPilih').textContent = n;
      btn.disabled = n === 0;
      btn.style.opacity = n === 0 ? '.5' : '';
      semua.checked = n === cek.length;
    }
    cek.forEach(function (c) { c.addEventListener('change', hitung); });
    semua.addEventListener('change', function () {
      cek.forEach(function (c) { c.checked = semua.checked; });
      hitung();
    });
    hitung();
  })();
</script>
<%- include('partials/footer') %>