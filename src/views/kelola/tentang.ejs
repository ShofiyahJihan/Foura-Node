<%- include('../partials/dash-header', { aktif: 'tentang', judul: 'Kelola Tentang Kami' }) %>
<%
const BARIS = [
  { nama: 'Teks & gambar halaman', isi: 'Hero, cerita, ajakan, dan gambar latar',
    ubah: '/kelola/tentang/teks/edit', hapus: '/kelola/tentang/teks/reset',
    tanya: 'Kembalikan semua teks dan gambar halaman ke bawaan?' },
  { nama: 'Keunggulan', isi: T.keunggulan.length + ' item',
    ubah: '/kelola/tentang/bagian/keunggulan', hapus: '/kelola/tentang/bagian/keunggulan/hapus',
    tanya: 'Hapus SEMUA item Keunggulan?' },
  { nama: 'Tim Kami', isi: T.tim.length + ' anggota',
    ubah: '/kelola/tentang/bagian/tim', hapus: '/kelola/tentang/bagian/tim/hapus',
    tanya: 'Hapus SEMUA anggota Tim Kami?' },
  { nama: 'Nilai & Visi', isi: T.nilai.length + ' item',
    ubah: '/kelola/tentang/bagian/nilai', hapus: '/kelola/tentang/bagian/nilai/hapus',
    tanya: 'Hapus SEMUA item Nilai & Visi?' },
];
%>
<section class="page">
  <h1>Kelola Tentang Kami</h1>
  <% if (ok) { %><p class="bantuan" style="color:#2f7a45">Tersimpan.</p><% } %>
  <% if (err) { %><p class="err"><%= err %></p><% } %>

  <div class="scroll-x">
    <table class="tabel">
      <thead><tr><th>Bagian</th><th>Isi</th><th>Aksi</th></tr></thead>
      <tbody>
        <% BARIS.forEach(b => { %>
          <tr>
            <td><b><%= b.nama %></b></td>
            <td class="muted"><%= b.isi %></td>
            <td class="aksi-sel">
              <a class="btn sm ghost" href="/tentang" target="_blank" rel="noopener">Lihat</a>
              <a class="btn sm ghost" href="<%= b.ubah %>">Ubah</a>
              <form method="post" action="<%= b.hapus %>" onsubmit="return confirm('<%= b.tanya %>')">
                <button type="submit" class="btn sm bahaya">Hapus</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../partials/dash-footer') %>